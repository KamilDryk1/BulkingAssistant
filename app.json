{
  "expo": {
    "name": "Bulking Assistant",
    "slug": "bulking-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "bulkingassistant",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0C",
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "bundleIdentifier": "com.anonymous.bulkingassistant"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0C",
        "foregroundImage": "./assets/brand/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.bulkingassistant"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C0C"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
