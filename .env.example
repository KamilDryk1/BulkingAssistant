# Public client configuration. Prefer the current publishable key for new Supabase projects.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy projects can use this instead of EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
